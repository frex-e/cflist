# Copy to .env and adjust for local development:
#   cp .env.example .env

# Public URL used for auth callbacks (match the host you open in the browser).
BETTER_AUTH_URL=http://localhost:3000

# Auth signing secret. Use a random 32+ character value outside local dev.
# BETTER_AUTH_SECRET=development-only-change-me-32-chars-min

# Optional GitHub OAuth. Leave both unset to disable GitHub sign-in.
# Register callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# GitHub-only sign-in (no email/password). Defaults to true when NODE_ENV=production.
# AUTH_GITHUB_ONLY=false

# PORT=3000
# HOST=127.0.0.1
# DB_PATH=./data/cflist.sqlite
# SYNC_INTERVAL_MINUTES=360
# SYNC_UNRATED_INTERVAL_MINUTES=60
# CONTEST_CACHE_TTL_DAYS=14
# CONTEST_CACHE_RECENT_COUNT=10
# AUTH_TRUSTED_ORIGINS=
# PUBLIC_ROOT=./src
